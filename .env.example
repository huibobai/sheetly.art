# Required. Public. The browser can see these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for AI styles. Server only. Do not prefix with NEXT_PUBLIC_.
FAL_KEY=

# Pre-launch is ON when this is unset. Launch day: set to false and redeploy.
# Off values: false, 0, off, no. Any other value stays on.
NEXT_PUBLIC_PRELAUNCH_MODE=

# Optional server-only fallback, used when NEXT_PUBLIC_PRELAUNCH_MODE is blank.
# PRELAUNCH_MODE=

# Optional origin for sitemap.xml. Defaults to https://sheetly.art.
# NEXT_PUBLIC_SITE_URL=https://sheetly.art

# Optional waitlist attempts per IP. Defaults: 6 per minute, 9 per day.
# WAITLIST_IP_PER_MINUTE_LIMIT=6
# WAITLIST_IP_DAILY_LIMIT=9

# Optional AI style limits. Defaults are in the README.
# GENERATE_DAILY_LIMIT=20
# GENERATE_PER_MINUTE_LIMIT=3
# GUEST_GENERATE_DAILY_LIMIT=3
# GUEST_IP_DAILY_LIMIT=9
# GUEST_IP_PER_MINUTE_LIMIT=6
